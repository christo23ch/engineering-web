# Sanity Studio environment (cms/ workspace). Copy to cms/.env.
# The project does not exist yet: it is created when the client ratifies
# DA-7 (Bible §49) — see docs/CMS.md for the full runbook.

# Sanity project id + dataset (from sanity.io/manage after `sanity init`).
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# Deployment the "Open preview" action resolves against (staging per DA-3).
SANITY_STUDIO_PREVIEW_URL=
