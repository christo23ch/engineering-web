# =============================================================================
# .env.example — Configuration contract (docs/PROJECT_BIBLE.md §38, SSOT).
# Copy to .env / .env.local and fill in values. NEVER commit real values.
# Variable names must match the canonical catalog in Bible §38 verbatim.
# Providers marked "DA-n" are open decisions (Bible §49), to close in Fase 0.
# =============================================================================

# ── CMS (headless — provider TBD, DA-7) ──────────────────────────────────────
CMS_API_URL=
CMS_API_TOKEN=

# ── Database (PostgreSQL + pgvector, EU — provider TBD, DA-5) ─────────────────
# DA-5 selection criterion: a serverless-capable connection pooler is required.
DATABASE_URL=
DATABASE_VECTOR_POOL_SIZE=

# ── CRM (lead delivery — provider TBD, DA-2) ─────────────────────────────────
CRM_API_BASE=
CRM_API_KEY=
CRM_WEBHOOK_SECRET=

# ── AI / Claude — generation (Anthropic, via BFF proxy only; ADR-005) ────────
AI_PROVIDER=anthropic
AI_PROVIDER_API_KEY=
AI_MODEL_DEFAULT=claude-haiku-4.5
AI_MODEL_COMPLEX=claude-opus-4-8
# DA-6: monthly AI budget cap and hard-stop cutoff when reached.
AI_MONTHLY_BUDGET=
AI_BUDGET_HARD_STOP=true

# ── Embeddings (RAG vectorization — provider TBD, DA-10; Voyage AI recommended)
# Anthropic has no embeddings API; a dedicated provider is required.
EMBEDDINGS_PROVIDER=voyage
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=voyage-3-lite

# ── Email transactional (provider TBD, DA-8) ─────────────────────────────────
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=noreply@example.com

# ── Analytics (provider TBD, DA-9; privacy-first preferred) ──────────────────
ANALYTICS_PROVIDER=
ANALYTICS_ID=

# ── Consent management platform (CMP) ────────────────────────────────────────
CMP_SITE_ID=

# ── Anti-abuse (forms / AI rate limiting; Bible §17) ─────────────────────────
RATE_LIMIT_WINDOW=
RATE_LIMIT_MAX=

# ── Environment (host-agnostic — hosting is DA-3, undecided) ─────────────────
SITE_URL=
NODE_ENV=production
ENVIRONMENT=
