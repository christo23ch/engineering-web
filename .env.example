# =============================================================================
# .env.example — Configuration contract (docs/PROJECT_BIBLE.md §38, SSOT).
# Copy to .env / .env.local and fill in values. NEVER commit real values.
# Variable names must match the canonical catalog in Bible §38 verbatim.
# Vendors below follow Bible §49 (governance-ratified, pending client): Sanity
# (DA-7), Supabase (DA-5), Brevo (DA-2 CRM / DA-8 email), Vercel (DA-3).
# =============================================================================

# ── CMS (Sanity — DA-7; GROQ HTTP endpoint) ──────────────────────────────────
# Full query endpoint, e.g.:
#   https://<projectId>.api.sanity.io/v2025-02-19/data/query/<dataset>
CMS_API_URL=
CMS_API_TOKEN=

# ── Database (PostgreSQL + pgvector, EU — Supabase, DA-5) ─────────────────────
# Use the transaction-mode pooler URL (serverless requirement, Bible §49 DA-5).
DATABASE_URL=
DATABASE_VECTOR_POOL_SIZE=

# ── CRM (lead delivery — Brevo, DA-2) ────────────────────────────────────────
CRM_API_BASE=https://api.brevo.com/v3
CRM_API_KEY=
CRM_WEBHOOK_SECRET=

# ── AI / Claude — generation (Anthropic, via BFF proxy only; ADR-005) ────────
AI_PROVIDER=anthropic
AI_PROVIDER_API_KEY=
AI_MODEL_DEFAULT=claude-haiku-4.5
AI_MODEL_COMPLEX=claude-opus-4-8
# DA-6: monthly AI budget cap and hard-stop cutoff when reached.
AI_MONTHLY_BUDGET=
AI_BUDGET_HARD_STOP=true

# ── Embeddings (RAG vectorization — provider TBD, DA-10; Voyage AI recommended)
# Anthropic has no embeddings API; a dedicated provider is required.
EMBEDDINGS_PROVIDER=voyage
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=voyage-3-lite

# ── Email transactional (Brevo — DA-8) ───────────────────────────────────────
EMAIL_PROVIDER=brevo
EMAIL_API_KEY=
EMAIL_FROM=noreply@example.com
# Internal inbox that receives new-lead / new-candidature notifications (ADR-008).
EMAIL_TO_INTERNAL=

# ── Analytics (provider TBD, DA-9; privacy-first preferred) ──────────────────
ANALYTICS_PROVIDER=
ANALYTICS_ID=

# ── Consent management platform (CMP) ────────────────────────────────────────
CMP_SITE_ID=

# ── Anti-abuse (forms / AI rate limiting; Bible §17) ─────────────────────────
# Durable fixed window: seconds per window + max requests per window and client.
# Defaults when unset: 3600 s / 5 requests.
RATE_LIMIT_WINDOW=
RATE_LIMIT_MAX=

# ── BFF outbox worker (ADR-010) ──────────────────────────────────────────────
# Bearer secret for the internal endpoint that drains the lead-delivery outbox.
# On Vercel (DA-3) duplicate the same value in CRON_SECRET (cron auto-injection).
OUTBOX_WORKER_SECRET=

# ── Environment (host-agnostic BFF; hosting per DA-3) ────────────────────────
SITE_URL=
NODE_ENV=production
ENVIRONMENT=
