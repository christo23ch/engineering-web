---
// Base layout. Loads global tokens and renders the shared Footer chrome
// (DESIGN_SYSTEM §11.4) on every page. Header/skip-link remain a later
// iteration (docs/PROJECT_BIBLE.md §46).
import '../styles/globals.css';
import Footer from '@/components/layout/Footer.astro';
import IaAssistant from '@/components/ia/IaAssistant.astro';

interface Props {
  title: string;
  description?: string;
  /** IA assistant widget — global on public pages, off on legal (§13.11). */
  assistant?: boolean;
}

const { title, description = '', assistant = true } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <slot />
    <Footer />
    {assistant && <IaAssistant />}
  </body>
</html>
