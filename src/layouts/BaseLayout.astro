---
// Base layout. Loads global tokens and renders the shared Footer chrome
// (DESIGN_SYSTEM §11.4) on every page. Header/skip-link remain a later
// iteration (docs/PROJECT_BIBLE.md §46).
import '../styles/globals.css';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import IaAssistant from '@/components/ia/IaAssistant.astro';

interface Props {
  title: string;
  description?: string;
  /** IA assistant widget — global on public pages, off on legal (§13.11). */
  assistant?: boolean;
}

const { title, description = '', assistant = true } = Astro.props;

// Canonical URL (nav/SEO): absolute, built from the configured `site`
// (astro.config) so every page declares its canonical route. Falls back to the
// request origin when `site` is unset (e.g. the test container).
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);

// Prefetch hint (performance, Hardening 3): P3 guarantees a single primary CTA
// per view, and it routes to /contacto on nearly every screen — the most likely
// next navigation. A static <link rel="prefetch"> is a browser-native hint (no
// JavaScript, unlike Astro's client-side prefetch integration), so it preserves
// the site's zero-JS property. Skipped on /contacto itself (nothing to prefetch).
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const prefetchContact = path !== '/contacto';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {prefetchContact && <link rel="prefetch" href="/contacto" />}
  </head>
  <body>
    <a
      href="#main-content"
      class="sr-only rounded-md focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:bg-action focus:px-4 focus:py-2 focus:text-on-action"
    >
      Saltar al contenido
    </a>
    <Header />
    <div id="main-content" tabindex="-1">
      <slot />
    </div>
    <Footer />
    {assistant && <IaAssistant />}
  </body>
</html>
