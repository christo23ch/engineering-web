---
/**
 * LeadMagnet — DESIGN_SYSTEM §13.6, Bible RF-13 / §42 L1. A minimal email +
 * consent capture block, interspersed in the resources context. Composes
 * APPROVED §11.3 primitives (Input, Checkbox, Button). Zero JS.
 *
 * Posts NATIVELY to `POST /api/leads` with `tipo=lead_magnet`, which selects
 * the magnet schema (email + recurso + consentimiento). `recurso` identifies
 * WHICH block captured the lead — the article slug on a resource page, or the
 * generic subscription on the index — so attribution is real, not invented.
 * Honest copy: it captures a subscription for future resources, it does not
 * promise a specific guide that does not exist yet.
 */
import Input from '@/components/ui/Input.astro';
import Checkbox from '@/components/ui/Checkbox.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import FormStatus from '@/components/content/FormStatus.astro';
import HoneypotField from '@/components/content/HoneypotField.astro';

interface Props {
  title?: string;
  /**
   * Slug attributing the capture (Bible §24 slug shape). Defaults to the
   * generic subscription used by the resources index.
   */
  recurso?: string;
  class?: string;
}
const {
  title = 'Recibe nuestras guías técnicas',
  recurso = 'suscripcion-general',
  class: className,
} = Astro.props;

// Unique per instance: several blocks can coexist on one page and each field
// still needs its own id/label association (§11.3 a11y).
const emailId = `magnet-email-${recurso}`;
const consentId = `magnet-consent-${recurso}`;
---

<div
  class:list={[
    'rounded-lg border border-blue-100 bg-blue-50 p-6 sm:p-8',
    className,
  ]}
>
  <div class="flex items-start gap-3">
    <Icon name="clipboard-check" size={24} class="mt-1 shrink-0 text-action" />
    <div>
      <p class="text-h3 font-semibold text-text-primary">{title}</p>
      <p class="mt-2 max-w-prose text-body text-text-secondary">
        Déjanos tu email y te avisamos cuando publiquemos guías y artículos
        técnicos. Sin spam.
      </p>
    </div>
  </div>

  <FormStatus class="mt-6" />

  <form method="post" action="/api/leads" class="mt-6 flex flex-col gap-4">
    <input type="hidden" name="tipo" value="lead_magnet" />
    <input type="hidden" name="recurso" value={recurso} />
    <HoneypotField />
    <Input
      id={emailId}
      label="Email"
      name="email"
      type="email"
      autocomplete="email"
      maxlength={254}
      required
    />
    <Checkbox id={consentId} name="consentimiento" required>
      Acepto recibir comunicaciones y he leído la
      <a href="/legal/privacidad" class="text-action underline">
        política de privacidad
      </a>.
    </Checkbox>
    <div>
      <Button type="submit">Suscribirme</Button>
    </div>
  </form>
</div>
