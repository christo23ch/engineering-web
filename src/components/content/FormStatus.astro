---
/**
 * FormStatus — outcome banners for the zero-JS form flow (Bible §13/§17,
 * DESIGN_SYSTEM §11.6 Alert).
 *
 * Pages are SSG, so they cannot read a query string server-side. The BFF
 * redirects a failed submission back to the form page with an outcome
 * FRAGMENT (server/http/form-flow.ts) and the matching banner is revealed
 * with CSS `:target`. Ids and copy come from `@/lib/forms/status`, the same
 * module the server picks the fragment from, so the two cannot drift apart.
 *
 * Safe without CSS: every banner carries the `hidden` attribute, so the user
 * agent's own stylesheet keeps them all collapsed even if the site stylesheet
 * never loads — the failure mode is "no banner", never four contradictory
 * ones at once. When the stylesheet is present, the author rule
 * `.form-status:target` (specificity 0,2,0) outranks the `[hidden]`
 * declaration (0,1,0) and reveals exactly the addressed banner.
 *
 * Fragment navigation scrolls to the banner and sets it as the focus starting
 * point; `tabindex="-1"` makes it programmatically focusable so that starting
 * point is the banner itself. Honest copy: it says what happened, never
 * claims the submission was stored, and never promises a wait shorter than
 * the configured window.
 */
import Alert from '@/components/ui/Alert.astro';
import { FORM_STATUS_BANNERS } from '@/lib/forms/status';

interface Props {
  /** Extra classes for the wrapper. */
  class?: string;
}
const { class: className } = Astro.props;
---

<div class:list={['flex flex-col gap-4', className]}>
  {
    FORM_STATUS_BANNERS.map((banner) => (
      <div
        id={banner.fragment}
        class="form-status"
        tabindex="-1"
        hidden="until-found"
      >
        <Alert variant={banner.variant} title={banner.title}>
          {banner.body}
        </Alert>
      </div>
    ))
  }
</div>

<style>
  /* Zero-JS reveal: only the banner named by the URL fragment is shown.
     `hidden="until-found"` is the no-CSS floor (see the component doc). Plain
     `hidden` would be unrevealable here: Tailwind's preflight enforces it as
     `display: none !important` from inside a cascade layer, and for important
     declarations layer order is inverted — a layered rule beats any unlayered
     one whatever its specificity. The preflight rule deliberately excludes
     `until-found`, so this ordinary declaration is free to win. */
  .form-status:target {
    display: block;
  }
</style>
