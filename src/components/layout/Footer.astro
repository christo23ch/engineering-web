---
/**
 * Footer — DESIGN_SYSTEM §11.4 / §8, Bible §24. Shared site chrome rendered by
 * BaseLayout on every page. Dark surface (blue-900 + on-dark), so it opts into
 * the dark focus-ring remap via data-surface="dark" (§10). Zero JS.
 *
 * Honest content: reduced site map + legal links (all real routes). DEFERRED,
 * not fabricated: certifications (H6 unvalidated), social links (no real URLs),
 * and the language selector (hidden until i18n, ADR-009). The wordmark uses the
 * provisional tagline, not a fabricated company name (H11).
 */
import { services } from '@/lib/content/services';
import { legalPages } from '@/lib/content/legal';

const company = [
  { href: '/proyectos', label: 'Proyectos' },
  { href: '/sobre-nosotros', label: 'Sobre nosotros' },
  { href: '/recursos', label: 'Recursos' },
  { href: '/empleo', label: 'Empleo' },
  { href: '/contacto', label: 'Contacto' },
];
const year = new Date().getFullYear();
---

<footer data-surface="dark" class="bg-blue-900 text-on-dark">
  <div
    class="mx-auto grid w-full max-w-content gap-10 px-4 py-16 sm:grid-cols-2 sm:px-6 lg:grid-cols-4 lg:px-8"
  >
    <div>
      <p class="text-h4 font-semibold">Ingeniería que rinde</p>
      <p class="mt-3 max-w-prose text-body-sm text-blue-100">
        Ingeniería industrial, energética, instalaciones y renovables con foco
        en eficiencia y resultados medibles.
      </p>
    </div>

    <nav aria-labelledby="footer-services">
      <h2 id="footer-services" class="text-body-sm font-semibold">Servicios</h2>
      <ul class="mt-3 space-y-2 text-body-sm text-blue-100">
        {
          services.map((service) => (
            <li>
              <a href={`/servicios/${service.slug}`} class="hover:underline">
                {service.name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav aria-labelledby="footer-company">
      <h2 id="footer-company" class="text-body-sm font-semibold">Empresa</h2>
      <ul class="mt-3 space-y-2 text-body-sm text-blue-100">
        {
          company.map((item) => (
            <li>
              <a href={item.href} class="hover:underline">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav aria-labelledby="footer-legal">
      <h2 id="footer-legal" class="text-body-sm font-semibold">Legal</h2>
      <ul class="mt-3 space-y-2 text-body-sm text-blue-100">
        {
          legalPages.map((page) => (
            <li>
              <a href={`/legal/${page.slug}`} class="hover:underline">
                {page.title}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="border-t border-white/10">
    <div
      class="mx-auto w-full max-w-content px-4 py-6 text-body-sm text-blue-100 sm:px-6 lg:px-8"
    >
      © {year} · Ingeniería que rinde
    </div>
  </div>
</footer>
