---
/**
 * Icon — single source of truth for SVG icons (DESIGN_SYSTEM §7 contract:
 * 24×24 grid, 1.75 stroke, rounded joins, currentColor, sizes 16/20/24/32).
 * Decorative by default (aria-hidden); pass `label` for a standalone accessible
 * icon (role="img" + aria-label). Zero JS. Geometry from src/lib/ui/icons.ts.
 */
import { icons, type IconName } from '@/lib/ui/icons';
import { cn } from '@/lib/utils/cn';

interface Props {
  name: IconName;
  /** Allowed sizes (px) — aligned to the 4px scale (§7). */
  size?: 16 | 20 | 24 | 32;
  /** Stroke width; defaults to the §7 value. Loaders may override (e.g. 3). */
  strokeWidth?: number;
  /** When set, the icon is meaningful: role="img" + aria-label. Else decorative. */
  label?: string;
  class?: string;
}

const {
  name,
  size = 24,
  strokeWidth = 1.75,
  label,
  class: className,
} = Astro.props;

const sizeClass = { 16: 'size-4', 20: 'size-5', 24: 'size-6', 32: 'size-8' }[
  size
];
const nodes = icons[name];
---

<svg
  class={cn(sizeClass, 'shrink-0', className)}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
>
  {
    nodes.map((node) => {
      const { tag, ...attrs } = node;
      return tag === 'circle' ? <circle {...attrs} /> : <path {...attrs} />;
    })
  }
</svg>
