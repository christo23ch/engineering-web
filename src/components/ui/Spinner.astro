---
/**
 * Spinner — decorative loading indicator (DESIGN_SYSTEM §10 "loading": 20px).
 * Thin wrapper over Icon (name="spinner", strokeWidth 3 for a loader look).
 * Decorative (Icon adds aria-hidden): the busy state is announced by the host's
 * aria-busy. Animation neutralized under prefers-reduced-motion by the global
 * rule. Zero JS.
 */
import Icon from '@/components/ui/Icon.astro';
import { cn } from '@/lib/utils/cn';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<Icon
  name="spinner"
  size={20}
  strokeWidth={3}
  class={cn('animate-spin', className)}
/>
