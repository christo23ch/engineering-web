---
/**
 * Spinner — decorative loading indicator (DESIGN_SYSTEM §10 "loading": 20px).
 * `aria-hidden`: the busy state is announced by the host element's `aria-busy`,
 * so the spinner must not add noise for assistive tech. Animation is neutralized
 * under prefers-reduced-motion by the global rule (src/styles/globals.css).
 */
import { cn } from '@/lib/utils/cn';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg
  class={cn('h-5 w-5 shrink-0 animate-spin', className)}
  viewBox="0 0 24 24"
  fill="none"
  aria-hidden="true"
>
  <circle
    cx="12"
    cy="12"
    r="10"
    stroke="currentColor"
    stroke-width="3"
    opacity="0.25"></circle>
  <path
    d="M12 2a10 10 0 0 1 10 10"
    stroke="currentColor"
    stroke-width="3"
    stroke-linecap="round"></path>
</svg>
