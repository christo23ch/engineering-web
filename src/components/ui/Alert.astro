---
/**
 * Alert — inline status/feedback message (DESIGN_SYSTEM §11.6). Four semantic
 * variants with an icon + text (colour is never the only signal). role is
 * status (polite) for info/success and alert (assertive) for warning/error;
 * override via `role`. Static and zero-JS — dismissible/auto-dismiss toasts are
 * a future island.
 */
import { cn } from '@/lib/utils/cn';
import {
  alertVariants,
  alertIconColor,
  alertRole,
  type AlertVariant,
} from '@/lib/ui/alert-variants';

interface Props {
  variant?: AlertVariant;
  title?: string;
  role?: 'status' | 'alert';
  class?: string;
}
const { variant = 'info', title, role, class: className } = Astro.props;
const resolvedRole = role ?? alertRole[variant];
---

<div role={resolvedRole} class={alertVariants({ variant, class: className })}>
  <svg
    class={cn('mt-0.5 h-5 w-5 shrink-0', alertIconColor[variant])}
    viewBox="0 0 20 20"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    {
      variant === 'warning' ? (
        <>
          <path d="M10 3 18 17H2L10 3Z" />
          <path d="M10 8v4" />
          <circle cx="10" cy="14.5" r="0.6" fill="currentColor" stroke="none" />
        </>
      ) : variant === 'success' ? (
        <>
          <circle cx="10" cy="10" r="8" />
          <path d="m6.5 10 2.5 2.5 4.5-5" />
        </>
      ) : variant === 'error' ? (
        <>
          <circle cx="10" cy="10" r="8" />
          <path d="m7 7 6 6M13 7l-6 6" />
        </>
      ) : (
        <>
          <circle cx="10" cy="10" r="8" />
          <path d="M10 9v4.5" />
          <circle cx="10" cy="6.5" r="0.6" fill="currentColor" stroke="none" />
        </>
      )
    }
  </svg>

  <div class="min-w-0">
    {title && <p class="font-medium">{title}</p>}
    <div class={title ? 'text-body-sm text-text-secondary' : undefined}>
      <slot />
    </div>
  </div>
</div>
