---
/**
 * FieldShell — shared label + help + error layout for form controls
 * (DESIGN_SYSTEM §11.3, Bible §20). The visible <label> is always present
 * (never placeholder-as-label). Help and error are linked to the control via
 * their ids (the control sets aria-describedby). Error carries an icon + text
 * so colour is never the sole signal (§3.3). Zero JS.
 */
import { cn } from '@/lib/utils/cn';
import FieldMessage from '@/components/ui/FieldMessage.astro';

interface Props {
  label: string;
  htmlFor: string;
  helpId: string;
  errorId: string;
  help?: string;
  error?: string;
  required?: boolean;
  class?: string;
}
const {
  label,
  htmlFor,
  helpId,
  errorId,
  help,
  error,
  required = false,
  class: className,
} = Astro.props;
---

<div class={cn('flex flex-col gap-2', className)}>
  <label for={htmlFor} class="text-label text-text-primary">
    {label}
    {
      required && (
        <span class="text-error">
          {' '}
          *<span class="sr-only"> (obligatorio)</span>
        </span>
      )
    }
  </label>

  <slot />

  <FieldMessage helpId={helpId} errorId={errorId} help={help} error={error} />
</div>
