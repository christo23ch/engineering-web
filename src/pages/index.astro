---
/**
 * Home (`/`) — DESIGN_SYSTEM §13.1, Bible RF-01 / CU-01 / B1 (lead generation).
 *
 * Built from APPROVED library primitives only (Button, Card, Icon); concrete
 * cards compose the Card primitive at the page level (§11.2), so no new
 * components are introduced.
 *
 * Faithful-to-SSOT content policy: sections whose data does not exist yet
 * (client logos, aggregate metrics, case studies, testimonials, resources) are
 * DEFERRED per the DS §13.1 rule "omite sin hueco vacío" — never faked. They
 * return when the CMS/content lands. Copy here is provisional (hero headline
 * pending H11; service descriptions are definitional, not fabricated claims).
 *
 * Header/Footer (§24 / §11.4) are separate components, deferred to their own
 * iterations; this screen delivers the Home content sections inside <main>.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';
import Card from '@/components/ui/Card.astro';
import Icon from '@/components/ui/Icon.astro';
import { services } from '@/lib/content/services';

// Differentiator pillars — drawn from Bible §1/§3 (data over adjectives,
// measurable results, applicable regulation). No fabricated figures.
const pillars = [
  'Datos antes que adjetivos: resultados medibles en cada proyecto.',
  'Foco en eficiencia energética y sostenibilidad rentable.',
  'Cumplimiento de la normativa técnica aplicable.',
];
---

<BaseLayout
  title="Ingeniería que rinde — proyectos medibles"
  description="Ingeniería industrial, energética, instalaciones y renovables con foco en eficiencia y resultados medibles."
>
  <main>
    <!-- 1 · Hero estándar (§12 patrón 6+6) -->
    <section aria-labelledby="hero-title" class="border-b border-border">
      <div
        class="mx-auto grid w-full max-w-content gap-10 px-4 py-16 sm:px-6 lg:grid-cols-2 lg:items-center lg:gap-16 lg:px-8 lg:py-24"
      >
        <div>
          <p class="text-overline text-text-muted uppercase">
            Ingeniería · Energía · Sostenibilidad
          </p>
          <h1
            id="hero-title"
            class="mt-3 text-h1 font-semibold text-balance text-text-primary"
          >
            Ingeniería que rinde: proyectos medibles en energía, industria e
            instalaciones
          </h1>
          <p class="mt-5 max-w-prose text-body-lg text-text-secondary">
            Ingeniería industrial, energética, instalaciones (MEP) y renovables
            con foco en eficiencia y resultados medibles.
          </p>
          <div class="mt-8 flex flex-wrap gap-4">
            <Button href="/contacto">Solicitar propuesta</Button>
            <Button href="/proyectos" variant="secondary">
              Ver casos de éxito
            </Button>
          </div>
        </div>

        <!-- Imagen real de proyecto pendiente (contenido/H10): placeholder
             decorativo con dimensiones reservadas (CLS). -->
        <div
          aria-hidden="true"
          class="flex aspect-[4/3] items-center justify-center rounded-lg border border-border bg-surface-muted"
        >
          <Icon name="layers" size={32} class="text-text-muted" />
        </div>
      </div>
    </section>

    <!-- 4 · Grid de 6 tarjetas de servicio (§12 grid de tarjetas) -->
    <section aria-labelledby="services-title" class="bg-surface-subtle">
      <div
        class="mx-auto w-full max-w-content px-4 py-16 sm:px-6 lg:px-8 lg:py-24"
      >
        <p class="text-overline text-text-muted uppercase">Qué hacemos</p>
        <h2
          id="services-title"
          class="mt-2 text-h2 font-bold text-text-primary"
        >
          Líneas de servicio
        </h2>

        <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {
            services.map((service) => (
              <li>
                <Card href={`/servicios/${service.slug}`} class="h-full">
                  <Icon name={service.icon} size={32} class="text-action" />
                  <h3 class="mt-4 text-h3 font-semibold text-text-primary">
                    {service.name}
                  </h3>
                  <p class="mt-2 text-body text-text-secondary">
                    {service.description}
                  </p>
                  <span class="mt-4 inline-flex items-center gap-1 text-label text-action">
                    Ver servicio
                    <Icon name="arrow-right" size={16} />
                  </span>
                </Card>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- 6 · Bloque diferencial (§12 split 6+6): sostenibilidad rentable -->
    <section aria-labelledby="value-title">
      <div
        class="mx-auto grid w-full max-w-content gap-10 px-4 py-16 sm:px-6 lg:grid-cols-2 lg:items-center lg:gap-16 lg:px-8 lg:py-24"
      >
        <div>
          <p class="text-overline text-text-muted uppercase">
            Por qué nosotros
          </p>
          <h2
            id="value-title"
            class="mt-2 text-h2 font-bold text-balance text-text-primary"
          >
            Sostenibilidad rentable, con resultados que se miden
          </h2>
          <p class="mt-5 max-w-prose text-body-lg text-text-secondary">
            No es un folleto: cada proyecto se orienta a datos y resultados
            comparables, con foco en eficiencia energética y cumplimiento
            normativo.
          </p>
        </div>

        <ul class="flex flex-col gap-4">
          {
            pillars.map((pillar) => (
              <li class="flex items-start gap-3">
                <Icon
                  name="check-circle"
                  size={24}
                  class="mt-0.5 shrink-0 text-success"
                />
                <span class="text-body text-text-primary">{pillar}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- 9 · Banda CTA final (§11.5 / §12): superficie oscura + botón invertido -->
    <section
      aria-labelledby="cta-title"
      data-surface="dark"
      class="bg-blue-900"
    >
      <div
        class="mx-auto flex w-full max-w-content flex-col items-start gap-6 px-4 py-16 sm:px-6 lg:px-8 lg:py-24"
      >
        <h2 id="cta-title" class="text-h2 font-bold text-balance text-on-dark">
          ¿Un reto de ingeniería con objetivos medibles? Hablemos.
        </h2>
        <p class="max-w-prose text-body-lg text-blue-100">
          Cuéntanos tu proyecto y te responde un ingeniero, no un bot.
        </p>
        <Button href="/contacto" variant="inverted">Solicitar propuesta</Button>
      </div>
    </section>
  </main>
</BaseLayout>
