---
/**
 * Portfolio (`/proyectos`) — DESIGN_SYSTEM §13.3, Bible RF-03 / CU-02.
 *
 * Composes APPROVED primitives only (Button, Icon); breadcrumbs are a
 * page-level composition of semantic HTML. Zero JS.
 *
 * Faithful-to-SSOT content: with no published case studies yet (CMS/DA-7) this
 * screen renders §13.3's own specified EMPTY STATE ("nunca página en blanco")
 * instead of fabricating projects — the Bible differentiator is real, verifiable
 * data, never invented metrics (§1/§3). DEFERRED until case data exists: the
 * filter bar (RF-03 needs data + a URL-state filtering island) and the case-card
 * grid with per-card metrics. They return with the CMS + a dedicated iteration.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
---

<BaseLayout
  title="Proyectos y casos de éxito — Ingeniería que rinde"
  description="Casos de ingeniería con resultados medibles: energía, industria, instalaciones y renovables."
  breadcrumbs={[
    { name: 'Inicio', href: '/' },
    { name: 'Proyectos', href: '/proyectos' },
  ]}
>
  <main>
    <!-- 1 · Hero interior (§12): breadcrumbs + overline + h1 + entradilla -->
    <section aria-labelledby="portfolio-title" class="bg-surface-subtle">
      <div class="mx-auto w-full max-w-content px-4 py-16 sm:px-6 lg:px-8">
        <nav aria-label="Migas de pan" class="text-body-sm text-text-muted">
          <ol class="flex flex-wrap items-center gap-2">
            <li><a href="/" class="text-action">Inicio</a></li>
            <li aria-hidden="true">/</li>
            <li aria-current="page" class="text-text-secondary">Proyectos</li>
          </ol>
        </nav>

        <p class="mt-6 text-overline text-text-muted uppercase">Proyectos</p>
        <h1
          id="portfolio-title"
          class="mt-2 text-h1 font-semibold text-balance text-text-primary"
        >
          Casos de éxito con resultados medibles
        </h1>
        <p class="mt-4 max-w-prose text-body-lg text-text-secondary">
          Cada proyecto se publica con datos reales y verificables: el resultado
          antes que el relato.
        </p>
      </div>
    </section>

    <!-- 3+4 · Estado vacío (§13.3 item 4): sin casos publicados aún, nunca
         página en blanco. El grid filtrable y las métricas por tarjeta llegan
         con el CMS. -->
    <section aria-labelledby="empty-title">
      <div
        class="mx-auto flex w-full max-w-prose flex-col items-center px-4 py-20 text-center sm:px-6 lg:px-8 lg:py-28"
      >
        <span
          class="flex size-16 items-center justify-center rounded-full bg-surface-muted"
        >
          <Icon name="layers" size={32} class="text-text-muted" />
        </span>
        <h2
          id="empty-title"
          class="mt-6 text-h3 font-semibold text-text-primary"
        >
          Casos de éxito en preparación
        </h2>
        <p class="mt-3 text-body text-text-secondary">
          Estamos documentando los proyectos con sus métricas verificadas. Muy
          pronto podrás explorarlos por sector, servicio y año.
        </p>
      </div>
    </section>

    <!-- 5 · Banda CTA final (§11.5): único CTA primario de la vista (P3) -->
    <section
      aria-labelledby="cta-title"
      data-surface="dark"
      class="bg-blue-900"
    >
      <div
        class="mx-auto flex w-full max-w-content flex-col items-start gap-6 px-4 py-16 sm:px-6 lg:px-8 lg:py-24"
      >
        <h2 id="cta-title" class="text-h2 font-bold text-balance text-on-dark">
          ¿Un reto similar en tu organización? Hablemos.
        </h2>
        <p class="max-w-prose text-body-lg text-blue-100">
          Cuéntanos tu proyecto y te responde un ingeniero, no un bot.
        </p>
        <Button href="/contacto" variant="inverted">Solicitar propuesta</Button>
      </div>
    </section>
  </main>
</BaseLayout>
