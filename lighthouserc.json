{
  "ci": {
    "collect": {
      "staticDistDir": "./dist/client",
      "numberOfRuns": 3,
      "url": [
        "http://localhost/index.html",
        "http://localhost/servicios/ingenieria-industrial/index.html",
        "http://localhost/proyectos/index.html",
        "http://localhost/recursos/index.html",
        "http://localhost/sobre-nosotros/index.html",
        "http://localhost/contacto/index.html"
      ]
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.9 }],
        "categories:accessibility": ["warn", { "minScore": 0.9 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }],
        "categories:seo": ["warn", { "minScore": 0.9 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
